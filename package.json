{
  "name": "tab-herder",
  "version": "0.1.0",
  "private": true,
  "description": "Manage Chrome tabs with native tab groups: auto-group, clean up, save sessions.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "icons": "node scripts/gen-icons.mjs",
    "e2e": "node tests/e2e/extension.e2e.mjs",
    "package": "node scripts/package.mjs",
    "screenshots": "node scripts/store-screenshots.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.7",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "preact": "^11.2.0"
  }
}
